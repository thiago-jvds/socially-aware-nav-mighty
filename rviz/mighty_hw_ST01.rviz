Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Common1/TF1/Frames1
        - /Common1/TF1/Tree1
        - /ST011
        - /ST011/Planning1
        - /ST011/Planning1/ST01 DGP path1
        - /ST011/Planning1/ST01 DGP path1/Topic1
        - /ST011/Planning1/ST01 DGP Free Path1
        - /ST011/Planning1/ST01 DGP Free Path1/Topic1
        - /ST011/Mapping1
        - /PointCloud21/Topic1
        - /PointCloud22/Topic1
        - /PointCloud23/Topic1
        - /PointCloud24
      Splitter Ratio: 0.5
    Tree Height: 530
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: PointCloud2
Visualization Manager:
